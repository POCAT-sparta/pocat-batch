# ================================================================
# POCAT Batch 환경 변수 예시
# 복사 후 실제 값 입력: cp .env.example .env
#
# [보안 주의]
# - 운영 환경에서는 .env 파일 대신 OS 환경변수 또는 Secrets Manager
#   (AWS KMS / HashiCorp Vault 등) 로 크리덴셜을 주입하세요.
# - .env 파일은 절대 Git에 커밋하지 마세요 (.gitignore 처리됨).
# - 운영 DB 계정은 최소 권한(pocat 테이블 + BATCH_* 테이블 읽기/쓰기만) 사용.
# ================================================================

# == 데이터베이스 ==
# 운영: RDS endpoint 사용. 로컬 개발용 기본값만 기재.
DB_URL=jdbc:mysql://localhost:3306/pocat?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=password   # 운영 환경에서는 강력한 패스워드로 교체 필수

# == Redis ==
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=        # Redis requirepass 설정 시 반드시 입력. 운영 환경 필수.

# == 배치 서버 ==
BATCH_SERVER_PORT=8081
